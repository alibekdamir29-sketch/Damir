# ─── DAMIR · переменные окружения ───────────────────────────────
# Скопируйте в .env и заполните. Никогда не коммитьте .env.

# PostgreSQL (обязательно)
DATABASE_URL="postgresql://damir:CHANGE_ME@localhost:5432/damir?schema=public"

# Публичный адрес магазина (для ссылок оплаты и webhook)
APP_URL="http://localhost:3000"

# Секрет для подписи сессий/корзины (обязательно, 32+ случайных символа):
#   openssl rand -base64 48
AUTH_SECRET=""

# ─── AI-консультант (Claude API) ────────────────────────────────
# Ключ: https://console.anthropic.com → API Keys. Без ключа чат показывает «не подключён».
ANTHROPIC_API_KEY=""
# Модель (по умолчанию claude-opus-5-5)
AI_MODEL="claude-opus-5-5"

# ─── Платежи ────────────────────────────────────────────────────
# none | test | cloudpayments
#   none          — онлайн-оплата скрыта, работают «при получении» и перевод
#   test          — тестовый провайдер, ТОЛЬКО для разработки (в production блокируется)
#   cloudpayments — реальные платежи (KZ)
PAYMENT_PROVIDER="none"
# Секрет подписи webhook тестового провайдера (openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=""
# CloudPayments: личный кабинет → Сайты → Настройки
CLOUDPAYMENTS_PUBLIC_ID=""
CLOUDPAYMENTS_API_SECRET=""
# Через сколько минут отменять неоплаченные онлайн-заказы и снимать резерв
UNPAID_ORDER_TTL_MINUTES="60"

# ─── Сервис ─────────────────────────────────────────────────────
# Bearer-токен для /api/cron/expire-orders (openssl rand -hex 32)
CRON_SECRET=""
# Папка для загруженных фото товаров
UPLOAD_DIR="./uploads"

# Docker/Railway: при старте создаёт администратора, если его ещё нет (пароль 10+ символов)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Только для npm run db:seed — создаст администратора
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
